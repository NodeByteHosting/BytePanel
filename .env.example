DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require

KV_REST_API_URL=https://example.upstash.io
KV_REST_API_TOKEN=

# Vercel Blob (snapshot agent binary)
BLOB_READ_WRITE_TOKEN=

# System-level Hetzner provider token used by GSM.
HETZNER_API_TOKEN=
# Optional: pin a golden image ID. If empty, GSM auto-manages snapshots.
HETZNER_SNAPSHOT_IMAGE_ID=

# Optional builder defaults used by provider profile.
HETZNER_BUILDER_BASE_IMAGE=ubuntu-24.04
HETZNER_BUILDER_SERVER_TYPE=cx23
HETZNER_BUILDER_LOCATION=nbg1

BOOTSTRAP_JWT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional public URL override for local snapshot bakes. Use ngrok/tunnel URL.
NODEBYTE_PUBLIC_URL=

VERCEL_AUTOMATION_BYPASS_SECRET=

# Stripe (optional unless billing/webhooks are in use)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SMTP (optional; when unset, email sending is skipped)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional local snapshot build tuning
SNAPSHOT_SKIP_FULL_UPGRADE=0
SNAPSHOT_BUILDER_MAX_WAIT_SECONDS=
SNAPSHOT_BUILDER_POLL_SECONDS=
SNAPSHOT_IMAGE_MAX_WAIT_SECONDS=
SNAPSHOT_IMAGE_POLL_SECONDS=

# Optional local git source override for snapshot compilation
NBP_GIT_REVISION=
NBP_GIT_REPO_URL=

# Optional token for private submodule access / sandbox git fetch
GIT_AUTH_TOKEN=
