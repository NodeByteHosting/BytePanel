{
  "name": "@bytepanel/web",
  "version": "0.1.0",
  "private": true,
  "description": "The BytePanel panel.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bunx --bun prisma generate && next build --webpack",
    "start": "next start",
    "analyze": "ANALYZE=true bun run build",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:generate": "bunx --bun prisma generate",
    "db:studio": "bunx --bun prisma studio",
    "migrate": "bunx --bun prisma migrate dev && bunx --bun prisma generate",
    "migrate:pterodactyl": "bun run scripts/migrate-pterodactyl.ts",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "types": "next typegen && tsgo --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.12",
    "@bytepanel/games": "workspace:*",
    "@bytepanel/protocol": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@noble/ed25519": "^3.2.0",
    "@nosecone/next": "1.14.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.9.0",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "anser": "^2.3.5",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.8.2",
    "human-id": "^4.2.2",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.8.1",
    "schema-dts": "^2.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.4",
    "@types/diff": "^8.0.0",
    "@types/gamedig": "^5.0.3",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "26.6.5",
