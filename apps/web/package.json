    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.2"
  }
