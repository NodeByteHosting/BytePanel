DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require

# Self-hosted Redis (redis:// or rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (avatars). Any provider works; requests use
# path-style URLs: <S3_ENDPOINT>/<S3_BUCKET>/<key>
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=bytepanel
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# BytePay: customer sign-in and the New Server page. Create a confidential OAuth
# client in BytePay with this redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/bytepay
BYTEPAY_URL=https://billing.example.com
BYTEPAY_API_URL=https://core.example.com
BYTEPAY_CLIENT_ID=
BYTEPAY_CLIENT_SECRET=

# Built-in billing (optional). Used when Admin > Settings > Billing is set to
# Built-in. Webhook URLs are shown on that page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=false

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public URL of the panel, used for links and written into daemon.json.
# Defaults to BETTER_AUTH_URL. Use a tunnel URL in local dev so daemons can
# reach /api/remote/*.
BYTEPANEL_PUBLIC_URL=

# SMTP (optional; when unset, email sending is skipped)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
