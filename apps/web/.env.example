DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require

# Self-hosted Redis (redis:// or rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# Vercel Blob (avatars)
BLOB_READ_WRITE_TOKEN=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# URL nodes use to reach the panel (written into daemon.json). Use a
# ngrok/tunnel URL in local dev so daemons can reach /api/remote/*.
NODEBYTE_PUBLIC_URL=

VERCEL_AUTOMATION_BYPASS_SECRET=

# Stripe (optional unless billing/webhooks are in use)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SMTP (optional; when unset, email sending is skipped)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
