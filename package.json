{
  "name": "nodebyte-gsm",
  "version": "0.1.0",
  "private": true,
  "description": "NodeByte GSM is our custom game server management platform.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@nodebyte/web",
    "dev:agent": "turbo run dev --filter=@nodebyte/agent",
    "build": "turbo run build --filter=@nodebyte/web",
    "build:agent": "turbo run build --filter=@nodebyte/agent",
    "start": "bun --filter @nodebyte/web start",
    "check": "turbo run lint",
    "fix": "turbo run fix",
    "types": "turbo run types",
    "test": "turbo run test",
    "validate": "turbo run validate",
    "db:deploy": "bun --filter @nodebyte/web db:deploy",
    "db:generate": "bun --filter @nodebyte/web db:generate",
    "db:studio": "bun --filter @nodebyte/web db:studio",
    "migrate": "bun --filter @nodebyte/web migrate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset tag",
    "prepare": "husky",
    "bump-deps": "npx npm-check-updates -u -x zod --deep && bun install",
    "prettier:check": "bunx prettier . --check",
    "prettier:run": "bunx prettier . --write"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "prettier": "3.9.10",
    "turbo": "^2.5.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
  }
}
