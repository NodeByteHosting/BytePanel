{
  "name": "@nodebyte/gsm",
  "version": "0.1.0",
  "description": "NodeByte GSM is our custom game server management platform.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:stripe": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "build": "bun run submodules:setup && bunx --bun prisma migrate deploy && bunx --bun prisma generate && next build --webpack",
    "start": "next start",
    "analyze": "ANALYZE=true bun run build",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:generate": "bunx --bun prisma generate",
    "db:studio": "bunx --bun prisma studio",
    "migrate": "bunx --bun prisma migrate dev && bunx --bun prisma generate",
    "agent:build": "node --eval \"const fs=require('fs');fs.mkdirSync(require('os').homedir()+'/.bun/install/cache',{recursive:true});fs.mkdirSync('dist',{recursive:true})\" && cd agent && bun build --compile --target=bun-linux-x64 ./src/index.ts --outfile ../dist/nodebyte-daemon",
    "agent:dev": "cd agent && bun run src/index.ts",
    "codegen": "openapi-typescript https://docs.hetzner.cloud/cloud.spec.json -o lib/providers/hetzner/schema.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "types": "next typegen && tsgo --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset tag",
    "prepare": "husky",
    "postinstall": "bun run submodules:setup && prisma generate",
    "setup:submodules": "bun run submodules:setup",
    "submodules:setup": "node scripts/submodules.mjs setup",
    "submodules:validate": "node scripts/submodules.mjs validate",
    "submodules:status": "node scripts/submodules.mjs status",
    "submodules:update": "node scripts/submodules.mjs update",
    "submodules:push": "node scripts/submodules.mjs push",
    "bump-deps": "npx npm-check-updates -u -x zod && bun install",
    "prettier:check": "bunx prettier . --check",
    "prettier:run": "bunx prettier . --write"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.12",
    "@monaco-editor/react": "^4.7.0",
    "@noble/ed25519": "^3.2.0",
    "@nosecone/next": "1.14.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.9.0",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^3.9.0",
    "@vercel/speed-insights": "^2.0.0",
    "anser": "^2.3.5",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.8.2",
    "human-id": "^4.2.2",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.8.1",
    "schema-dts": "^2.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.4",
    "@types/diff": "^8.0.0",
    "@types/gamedig": "^5.0.3",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260507.1",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.2",
    "vercel": "^65.2.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
  }
}
