<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'icon' => 'fas fa-plus',
        'name' => $this->_('Bytepanel.manage.add', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . (int) $module->id],
    ],
]);
$this->Widget->create($this->_('Bytepanel.manage.title', true), ['id' => 'manage_bytepanel']);
?>
<div class="inner">
    <?php if (empty($module->rows)) { ?>
    <div class="empty_section">
        <div class="empty_box"><?php $this->_('Bytepanel.manage.empty'); ?></div>
    </div>
    <?php } else { ?>
    <table class="table">
        <tr class="heading_row">
            <td><span><?php $this->_('Bytepanel.manage.name'); ?></span></td>
            <td><span><?php $this->_('Bytepanel.manage.url'); ?></span></td>
            <td class="last"><span><?php $this->_('Bytepanel.manage.options'); ?></span></td>
        </tr>
        <?php foreach ($module->rows as $i => $row) { ?>
        <tr<?php echo $i % 2 == 1 ? ' class="odd_row"' : ''; ?>>
            <td><?php $this->Html->_($row->meta->panel_name); ?></td>
            <td><?php $this->Html->_($row->meta->url); ?></td>
            <td>
                <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . (int) $module->id . '/' . (int) $row->id . '/'); ?>"><?php $this->_('Bytepanel.manage.edit'); ?></a>,
                <?php
                $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                $this->Form->fieldHidden('id', $module->id);
                $this->Form->fieldHidden('row_id', $row->id);
                ?>
                <a href="#" class="manage" rel="<?php $this->Html->_($this->_('Bytepanel.manage.delete_confirm', true)); ?>"><?php $this->_('Bytepanel.manage.delete'); ?></a>
                <?php $this->Form->end(); ?>
            </td>
        </tr>
        <?php } ?>
    </table>
    <?php } ?>
</div>
<?php
$this->Widget->end();
?>
<script type="text/javascript">
    $(document).ready(function () {
        $('#manage_bytepanel a.manage[rel]').blestaModalConfirm({
            base_url: '<?php echo $this->Html->safe($this->base_uri); ?>',
            close: '<?php $this->_('AppController.modal.text_close'); ?>',
            submit: true
        });
    });
</script>
